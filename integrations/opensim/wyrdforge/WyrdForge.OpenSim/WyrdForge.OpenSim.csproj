<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      No OpenSim.Framework reference here, deliberately: this project is
      the host-free bridge core (AvatarMapper, ChatCommandParser,
      WyrdForgeRegionModule) and stays unit-testable standalone.

      The OpenSim.Framework dependency lives exactly where a real
      deployment needs it — in the sibling deployment project
      WyrdForge.OpenSim.RegionModule, whose WyrdForgeRegionModuleHost
      implements IRegionModuleBase (via INonSharedRegionModule) on top
      of this core. See that project's README.md. (E3: before E3 this
      comment told deployers to implement IRegionModuleBase themselves;
      the implementation now ships.)
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\sdk\csharp\WyrdForge.Client\WyrdForge.Client.csproj" />
  </ItemGroup>

</Project>
